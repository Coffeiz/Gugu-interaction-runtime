{
  "name": "gugu-interaction-runtime",
  "version": "3.0.8",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coffeiz/Gugu-interaction-runtime.git"
  },
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./vue": {
      "types": "./dist-lib/vue/index.d.ts",
      "import": "./dist-lib/vue.js"
    },
    "./runtime/move/MoveAdapter": {
      "types": "./dist-lib/runtime/move/MoveAdapter.d.ts",
      "import": "./dist-lib/runtime/move/MoveAdapter.js"
    }
  },
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "vue-tsc --noEmit && vite build --config vite.lib.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:ui": "env -u NO_COLOR playwright test --ui",
    "benchmark:real-page": "node scripts/run-real-page-smoke.mjs",
    "benchmark": "node scripts/run-benchmark.mjs",
    "benchmark:report": "node scripts/summarize-benchmark.mjs",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@dnd-kit/vue": "^0.5.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/language-core": "^3.3.13",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12",
    "vue": "^3.5.44",
    "vue-tsc": "^2.1.0"
  }
}
