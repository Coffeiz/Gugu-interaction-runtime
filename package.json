{
  "name": "gugu-interaction-runtime",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Coffeiz/Gugu-interaction-runtime.git"
  },
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./vue/useSurface": {
      "types": "./dist-lib/vue/useSurface.d.ts",
      "import": "./dist-lib/vue/useSurface.js"
    },
    "./vue/useObject": {
      "types": "./dist-lib/vue/useObject.d.ts",
      "import": "./dist-lib/vue/useObject.js"
    },
    "./vue/useRuntimeTransition": {
      "types": "./dist-lib/vue/useRuntimeTransition.d.ts",
      "import": "./dist-lib/vue/useRuntimeTransition.js"
    },
    "./runtime/detach/DetachAdapter": {
      "types": "./dist-lib/runtime/detach/DetachAdapter.d.ts",
      "import": "./dist-lib/runtime/detach/DetachAdapter.js"
    }
  },
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "vue-tsc --noEmit && vite build --config vite.lib.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/language-core": "^3.3.9",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
